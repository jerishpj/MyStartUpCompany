{
  "Observability": {
    "Enabled": true,
    "ServiceName": "MyStartUpCompany.Api",
    "ServiceVersion": "1.0.0",
    "Environment": "production",
    "ServiceNamespace": "mystartupcorp",
    "SamplingRate": 0.1,
    "BatchSize": 1024,
    "ExportInterval": 30000,
    "Exporters": {
      "Otlp": {
        "Enabled": true,
        "Endpoint": "http://otel-collector:4317",
        "Protocol": "grpc",
        "ExportTimeout": 30000,
        "MaxConcurrentRequests": 10
      },
      "AzureMonitor": {
        "Enabled": false,
        "ConnectionString": "",
        "ExportTimeout": 30000
      },
      "Console": {
        "Enabled": false,
        "Targets": "All"
      }
    },
    "Instrumentation": {
      "AspNetCore": true,
      "Http": true,
      "SqlClient": true,
      "Runtime": true,
      "Process": true,
      "Redis": false,
      "Custom": []
    },
    "Sampling": {
      "DefaultRate": 0.1,
      "ErrorRate": 1.0,
      "SlowRequestRate": 1.0,
      "SlowRequestThreshold": 1000,
      "AdaptiveSampling": true,
      "AdaptiveTargetTracesPerSecond": 100
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "Api": {
    "BaseUrl": "https://api.mystartupcorp.com",
    "Version": "v1",
    "MaxPageSize": 100,
    "DefaultPageSize": 20,
    "IncludeExceptionDetails": false,
    "RequestTimeoutSeconds": 30,
    "EnableApiDocumentation": true,
    "EnableCors": true,
    "AllowedCorsOrigins": "*",
    "EnableRequestCompression": true,
    "EnableResponseCompression": true
  },
  "Database": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=MyStartUpCompanyDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Provider": "SqlServer",
    "EnableDetailedLogging": false,
    "CommandTimeoutSeconds": 30,
    "EnableQueryCache": true,
    "ConnectionPoolSize": 20,
    "RetryPolicy": {
      "Enabled": true,
      "MaxRetries": 3,
      "DelayMilliseconds": 1000
    }
  },
  "Cache": {
    "Enabled": true,
    "Provider": "Memory",
    "DefaultDurationSeconds": 300,
    "KeyPrefix": "api:",
    "MaxSizeInMegabytes": 100,
    "EnableCompression": false
  },
  "FeatureFlags": {
    "EnableAdvancedSearch": false,
    "EnableExport": false,
    "EnableBatchOperations": false,
    "EnableRealTimeNotifications": false,
    "EnableRateLimiting": false,
    "RateLimitRequestsPerMinute": 100,
    "EnableVersioning": true,
    "EnableResponseCaching": true,
    "EnablePagination": true,
    "EnableFiltering": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MyStartUpCompanyDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AllowedHosts": "*"
}
