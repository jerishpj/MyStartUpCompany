# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /build

# Copy project files
COPY ["src/MyStartUpCompany.Api/MyStartUpCompany.Api.csproj", "src/MyStartUpCompany.Api/"]
COPY ["src/MyStartUpCompany.Persistence/MyStartUpCompany.Persistence.csproj", "src/MyStartUpCompany.Persistence/"]
COPY ["src/MyStartUpCompany.Observability/MyStartUpCompany.Observability.csproj", "src/MyStartUpCompany.Observability/"]

# Restore dependencies
RUN dotnet restore "src/MyStartUpCompany.Api/MyStartUpCompany.Api.csproj"

# Copy source code
COPY . .

# Build application
RUN dotnet build "src/MyStartUpCompany.Api/MyStartUpCompany.Api.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "src/MyStartUpCompany.Api/MyStartUpCompany.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy published application
COPY --from=publish /app/publish .

# Set environment for observability
ENV OTEL_SDK_DISABLED=false
ENV OTEL_TRACES_EXPORTER=otlp
ENV OTEL_METRICS_EXPORTER=otlp
ENV OTEL_EXPORTER_OTLP_PROTOCOL=grpc
ENV OTEL_SERVICE_NAME=MyStartUpCompany.Api
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
	CMD curl -f http://localhost:8080/health || exit 1

# Expose ports
EXPOSE 8080

# Run application
ENTRYPOINT ["dotnet", "MyStartUpCompany.Api.dll"]
